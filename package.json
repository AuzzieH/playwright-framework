{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "Playwright test automation framework with UI (SauceDemo) and API (Restful-Booker) testing using a Feature/Step/Page layered architecture in TypeScript",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=ui-chromium",
    "test:ui:headed": "npx playwright test --project=ui-chromium --headed",
    "test:ui:firefox": "npx playwright test --project=ui-firefox",
    "test:ui:webkit": "npx playwright test --project=ui-webkit",
    "test:api": "npx playwright test --project=api",
    "test:all": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep-invert @smoke",
    "test:debug": "npx playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "npx playwright show-report",
    "report:allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "typescript",
    "page-object-model",
    "feature-step-page",
    "api-testing",
    "test-architecture"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0",
    "dotenv": "^16.4.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.1"
  }
}
